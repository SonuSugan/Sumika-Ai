# Sumika backend config - copy this file to backend/.env and fill in what you have.
# You do NOT need all of these. Sumika tries each configured provider in order
# (fastest free ones first) and silently falls back to the next if one fails.
# Every provider below has a free tier, or (Ollama) is fully free & local.

PORT=5175

# MongoDB Atlas (free M0 tier) - stores your profile/resume for job-application autofill.
# https://cloud.mongodb.com - create a free cluster, a database user, and grab the connection string.
MONGODB_URI=
MONGODB_DB=sumika

PROVIDER_ORDER=groq,cerebras,gemini,openrouter,together,mistral,deepseek,nvidia,huggingface,perplexity,github,cohere,cloudflare,ollama

# 1. Groq - https://console.groq.com/keys (free, extremely fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. Cerebras - https://cloud.cerebras.ai (free tier, fastest inference around)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# 3. Google Gemini - https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4. OpenRouter - https://openrouter.ai/keys (many :free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Together AI - https://api.together.ai (free-tier models)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# 6. Mistral AI - https://console.mistral.ai (free tier)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 7. DeepSeek - https://platform.deepseek.com (cheap/free-credit tier)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 8. NVIDIA NIM - https://build.nvidia.com (free API catalog)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 9. Hugging Face - https://huggingface.co/settings/tokens (free inference router)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# 10. Perplexity - https://www.perplexity.ai/settings/api (free trial credit)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# 11. GitHub Models - https://github.com/marketplace/models (free with a GitHub account)
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# 12. Cohere - https://dashboard.cohere.com/api-keys (free trial tier)
COHERE_API_KEY=
COHERE_MODEL=command-r

# 13. Cloudflare Workers AI - https://dash.cloudflare.com (generous daily free tier)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 14. Ollama - https://ollama.com (fully local & free, no key, no internet needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
